#N canvas 40 40 720 620 12;
#X text 24 20 alien package load-tester;
#X text 24 40 One instance of every object in the library. On load \, check the Pd console: any object printed with a dashed border or a "couldn't create" error failed to load.;
#X obj 24 100 alien;
#X obj 24 130 alien_wrap;
#X obj 24 160 alien_join 3;
#X obj 24 190 alien_snap 0 2 4 5 7 9 11;
#X obj 24 220 alien_scale 0 2 4 5 7 9 11;
#X obj 24 250 alien_cue 4;
#X obj 24 280 alien_orchestrate;
#X obj 360 100 ns_archive;
#X obj 360 130 ns_mutate gaussian 0.1;
#X obj 360 160 ns_log /tmp/pkg_tester.csv;
#X obj 360 190 ns_grid_stats 4 4;
#X obj 360 220 ns_spigot 0.3;
#X obj 360 250 ns_seq_features;
#X obj 360 280 ns_seq_propose mutate 0.2;
#X obj 360 310 ns_seq_info;
#X obj 360 340 ns_quality;
#X obj 360 370 ns_corpus;
#X obj 360 400 ns_ast_features;
#X text 24 560 If every box above is solid \, the package loaded correctly on this architecture.;
